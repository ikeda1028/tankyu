rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function ownId(userId) {
      return userId == email().replace('[/.#\\[\\]\\s]', '_');
    }
    function ownsExisting() {
      return resource.data.email.lower() == email();
    }
    match /wakuwakuUsers/{userId} {
      allow get: if verified() &&
        (exists(/databases/$(database)/documents/wakuwakuUsers/$(userId)) ? ownsExisting() : ownId(userId));
      allow list: if verified() && resource.data.emailLower == email();
      allow create: if verified() && ownId(userId)
        && request.resource.data.emailLower == email()
        && request.resource.data.email.lower() == email();
      allow update: if verified() && ownsExisting()
        && request.resource.data.emailLower == email()
        && request.resource.data.email.lower() == email();
      allow delete: if false;
    }
    match /publicExplorers/{ownerId}/{kind}/{recordId} {
      allow read: if ownerId == 'ikeda@manabinomichi_com' && kind in ['points', 'worlds'];
      allow write: if ownerId == 'ikeda@manabinomichi_com' && kind in ['points', 'worlds'] && verified()
        && email() == 'ikeda@manabinomichi.com';
    }
  }
}
